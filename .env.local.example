# Backend API
NEXT_PUBLIC_API_BASE_URL="http://localhost:4011"
NEXT_PUBLIC_API_URL="/api/pina"
BACKEND_URL="http://localhost:4011"

# Google OAuth (Frontend Client ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Google Cloud Storage (bucket para uploads)
NEXT_PUBLIC_GCS_BUCKET=""

# Mercado Pago
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
